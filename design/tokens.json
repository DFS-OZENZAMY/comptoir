{
  "$description": "Jetons du design Comptoir, identiques à la collection de variables « Comptoir » du fichier Figma et aux variables CSS du code.",
  "color": {
    "ink": "#17181C",
    "ink-2": "#2A2C33",
    "canvas": "#F4F4F1",
    "surface": "#FFFFFF",
    "line": "#E3E3DF",
    "muted": "#6B6F78",
    "signal": "#E4572E",
    "signal-strong": "#C9461F",
    "signal-soft": "#FCE8E1",
    "ok": "#2E7D4F",
    "ok-soft": "#E1F1E7",
    "warn": "#B7791F",
    "warn-soft": "#FBF0D9",
    "bad": "#B3261E",
    "bad-soft": "#F8E1DE",
    "info": "#2D5F8A",
    "info-soft": "#E1ECF6"
  },
  "space": { "4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "48": 48 },
  "radius": { "control": 8, "card": 12, "tile": 16, "pill": 999 },
  "font": {
    "interface": "Archivo",
    "display": "Archivo Narrow",
    "receipt": "IBM Plex Mono"
  },
  "text": {
    "Display/XL": { "font": "Archivo Narrow", "weight": 700, "size": 88, "lineHeight": 84 },
    "Display/L": { "font": "Archivo Narrow", "weight": 700, "size": 56, "lineHeight": 56 },
    "Title/H1": { "font": "Archivo Narrow", "weight": 700, "size": 36, "lineHeight": 40 },
    "Title/H2": { "font": "Archivo", "weight": 600, "size": 20, "lineHeight": 28 },
    "Title/H3": { "font": "Archivo", "weight": 600, "size": 16, "lineHeight": 22 },
    "Body/L": { "font": "Archivo", "weight": 400, "size": 18, "lineHeight": 28 },
    "Body/M": { "font": "Archivo", "weight": 400, "size": 15, "lineHeight": 22 },
    "Body/S": { "font": "Archivo", "weight": 400, "size": 13, "lineHeight": 18 },
    "Label/M": { "font": "Archivo", "weight": 600, "size": 14, "lineHeight": 20 },
    "Label/S": { "font": "Archivo", "weight": 500, "size": 12, "lineHeight": 16 },
    "Number/L": { "font": "Archivo", "weight": 700, "size": 30, "lineHeight": 34 },
    "Number/M": { "font": "Archivo", "weight": 700, "size": 20, "lineHeight": 26 },
    "Receipt/M": { "font": "IBM Plex Mono", "weight": 400, "size": 13, "lineHeight": 20 },
    "Receipt/Total": { "font": "IBM Plex Mono", "weight": 600, "size": 18, "lineHeight": 24 }
  }
}
