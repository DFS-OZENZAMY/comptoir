{
  "name": "comptoir",
  "version": "1.0.0",
  "private": true,
  "description": "Comptoir : plateforme de caisse, stock, facturation et vitrine en ligne pour les commerces",
  "scripts": {
    "start": "node src/adapters/node/server.js",
    "dev": "node --watch src/adapters/node/server.js",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "wrangler": "4.142.0"
  },
  "type": "module",
  "optionalDependencies": {
    "@libsql/client": "^0.18.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
