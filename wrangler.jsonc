{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit correspondre au nom du Worker dans le tableau de bord Cloudflare.
  "name": "comptoir",
  "main": "src/adapters/cloudflare.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/s/*", "/logiciel-de-caisse", "/logiciel-de-caisse/*", "/sitemap.xml", "/robots.txt", "/mentions-legales", "/cgu", "/cgv", "/confidentialite", "/aide", "/aide/*"]
  },

  // Base de données de la plateforme : créée automatiquement au premier déploiement.
  "d1_databases": [
    { "binding": "DB", "database_name": "comptoir-data" }
  ],

  // E-mails d'alertes du matin (6 h UTC).
  "triggers": { "crons": ["0 6 * * *"] },

  "keep_vars": true,
  "observability": { "enabled": true },
  // Messagerie en temps réel : Durable Object stocké en SQLite (disponible dans la formule gratuite de Workers)
  "durable_objects": { "bindings": [{ "name": "CHAT_HUB", "class_name": "ChatHub" }] },
  "migrations": [{ "tag": "messagerie-v1", "new_sqlite_classes": ["ChatHub"] }],
  // Vérifications avant chaque déploiement par Cloudflare (ESLint + tests) : un échec annule le déploiement.
  "build": { "command": "node scripts/predeploy.js" }
}
