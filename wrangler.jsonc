{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Doit correspondre au nom du Worker dans le tableau de bord Cloudflare.
  "name": "comptoir",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/s/*", "/logiciel-de-caisse", "/logiciel-de-caisse/*", "/sitemap.xml", "/robots.txt"]
  },

  // Base de données de la plateforme : créée automatiquement au premier déploiement.
  "d1_databases": [
    { "binding": "DB", "database_name": "comptoir-data" }
  ],

  // E-mails d'alertes du matin (6 h UTC).
  "triggers": { "crons": ["0 6 * * *"] },

  "keep_vars": true,
  "observability": { "enabled": true }
}
