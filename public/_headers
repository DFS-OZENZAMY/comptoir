# Polices : fichiers qui ne changent jamais, mis en cache un an par le navigateur
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images et icônes du site
/assets/*.png
  Cache-Control: public, max-age=604800
/assets/favicon.svg
  Cache-Control: public, max-age=604800

# Espace commerçant et console : jamais indexés
/app/*
  X-Robots-Tag: noindex
/console/*
  X-Robots-Tag: noindex
