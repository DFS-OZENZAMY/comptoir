# Sécurité : sur tous les fichiers (les réponses de l'application reçoivent les mêmes, src/app.js)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(), geolocation=(), payment=()

# Espace commerçant, console et site : jamais affichés dans un cadre d'un autre site (clickjacking).
# Application et console : toujours vérifiées auprès du serveur (no-cache, réponse 304 si rien n'a changé),
# pour qu'une mise à jour soit visible dès le chargement suivant.
/
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/app/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-cache
/console/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: no-cache

# Polices : fichiers qui ne changent jamais, mis en cache un an par le navigateur
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images et icônes du site
/assets/*.png
  Cache-Control: public, max-age=604800
/assets/favicon.svg
  Cache-Control: public, max-age=604800

# Espace commerçant et console : jamais indexés
/app/*
  X-Robots-Tag: noindex
/console/*
  X-Robots-Tag: noindex

# Application installable : le service worker est toujours vérifié
/app/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /app/
/manifest.webmanifest
  Cache-Control: public, max-age=3600

# Lecteurs de bases de données (chargés seulement pour l'import)
/vendor/*
  Cache-Control: public, max-age=604800
