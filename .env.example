# Configuration de Comptoir hors Cloudflare (copiez ce fichier en « .env »).
# Sur Cloudflare, ces valeurs se règlent dans Settings → Variables and Secrets.

# --- Serveur ---------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Derrière un proxy ou un répartiteur de charge (Nginx, Traefik, AWS ALB, Cloud Run…) :
# l'adresse https et le domaine sont lus dans X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY=true
# Adresse publique : un seul domaine pour Google (les autres redirigent vers lui).
APP_URL=https://comptoir.example.com
APP_VERSION=dev

# --- Base de données ---------------------------------------------------------
# Un seul serveur : fichier SQLite local (défaut).
DATABASE_URL=file:./data/comptoir.db
# Plusieurs serveurs : base libSQL partagée (Turso ou serveur libSQL auto-hébergé).
# DATABASE_URL=libsql://comptoir-votre-org.turso.io
# DATABASE_AUTH_TOKEN=...

# --- Photos des produits -----------------------------------------------------
# fs (disque, défaut hors Cloudflare) | db (dans la base) | s3 (stockage compatible S3)
STORAGE_DRIVER=fs
FILES_DIR=./data/files
# Pour s3 (AWS S3, MinIO, Scaleway, OVH, Backblaze B2, Wasabi, Cloudflare R2…) :
# S3_ENDPOINT=https://s3.fr-par.scw.cloud     (laisser vide pour AWS)
# S3_REGION=fr-par
# S3_BUCKET=comptoir-photos
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PATH_STYLE=true

# --- Sauvegardes (voir docs/BACKUP.md) --------------------------------------------
# Destination distincte de la production : s3 (recommandé), r2 (Cloudflare), fs (dossier local, par défaut).
BACKUP_DRIVER=fs
BACKUP_DIR=./data/backups
# BACKUP_DRIVER=s3
# BACKUP_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net   (laisser vide pour AWS)
# BACKUP_S3_REGION=gra
# BACKUP_S3_BUCKET=comptoir-sauvegardes
# BACKUP_S3_ACCESS_KEY_ID=...
# BACKUP_S3_SECRET_ACCESS_KEY=...
# Clé de chiffrement (openssl rand -base64 32). À conserver en deux endroits sûrs : sans elle, les sauvegardes sont illisibles.
# BACKUP_ENCRYPTION_KEY=...
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
BACKUP_INCLUDE_FILES=true

# --- Plateforme ----------------------------------------------------------------
# Adresses e-mail des administrateurs de la plateforme (accès à la console), séparées par des virgules.
PLATFORM_ADMIN_EMAILS=vous@exemple.com
# Tâche du matin (statistiques, nettoyage, e-mails d'alertes), heure UTC. Sûre avec plusieurs serveurs.
CRON_HOUR_UTC=6
DISABLE_CRON=false
LOG_REQUESTS=false

# --- E-mails (facultatif, Resend) -----------------------------------------------
# RESEND_API_KEY=re_...
# MAIL_FROM=Comptoir <alertes@comptoir.example.com>

# --- Pages légales ----------------------------------------------------------------
# LEGAL_NAME=  LEGAL_FORM=  LEGAL_ADDRESS=  LEGAL_ID=  LEGAL_DIRECTOR=
# LEGAL_EMAIL=  LEGAL_PHONE=  LEGAL_CNDP=  LEGAL_LAW=  LEGAL_COURT=
